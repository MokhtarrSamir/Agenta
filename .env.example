# ------------------------------------------------------------------
# Backend (FastAPI) configuration
# ------------------------------------------------------------------

# MongoDB connection string used by the FastAPI app.
# When running with docker compose, the host is `mongodb` (service name);
# for local development use `localhost`.
MONGODB_URI=mongodb://root:rootpassword@localhost:27017
# Database name used for application data (documents, metadata, chat history).
MONGODB_DB_NAME=rag_agent

# Qdrant URL and gRPC/REST HTTP port used by the FastAPI app.
# When running with docker compose, use http://qdrant:6333.
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333

# ------------------------------------------------------------------
# Docker Compose settings
# ------------------------------------------------------------------

# Mongo root credentials (used by the mongodb container and the app URI).
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=rootpassword
# Host ports exposed by docker compose (change if ports are taken).
MONGODB_PORT=27017
BACKEND_PORT=8000

# ------------------------------------------------------------------
# Placeholders for future phases (NOT used yet)
# ------------------------------------------------------------------

# Groq API key for the LLM (RAG answer generation). Not implemented yet.
GROQ_API_KEY=
# Tavily API key for web search via MCP. Not implemented yet.
TAVILY_API_KEY=